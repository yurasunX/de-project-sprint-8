# Use a private .local/project.env. Never commit real credentials.
KAFKA_BOOTSTRAP_SERVERS=kafka-bootstrap.de.education-services.ru:9094
KAFKA_INPUT_TOPIC=YOUR_INPUT_TOPIC
KAFKA_OUTPUT_TOPIC=YOUR_OUTPUT_TOPIC
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_USERNAME=YOUR_KAFKA_USERNAME
KAFKA_PASSWORD=YOUR_KAFKA_PASSWORD
KAFKA_TRUSTSTORE_LOCATION=
KAFKA_TRUSTSTORE_PASSWORD=
KAFKA_CA_LOCATION=
KAFKA_GROUP_ID_PREFIX=
SOURCE_PG_HOST=YOUR_POSTGRES_HOST
SOURCE_PG_PORT=5432
SOURCE_PG_DATABASE=de
SOURCE_PG_USER=YOUR_POSTGRES_USERNAME
SOURCE_PG_PASSWORD=YOUR_POSTGRES_PASSWORD
SOURCE_PG_SSLMODE=prefer
FEEDBACK_PG_HOST=localhost
FEEDBACK_PG_PORT=5432
FEEDBACK_PG_DATABASE=de
FEEDBACK_PG_USER=YOUR_POSTGRES_USERNAME
FEEDBACK_PG_PASSWORD=YOUR_POSTGRES_PASSWORD
FEEDBACK_PG_SSLMODE=prefer
SOURCE_TABLE=public.subscribers_restaurants
FEEDBACK_TABLE=public.subscribers_feedback
CHECKPOINT_LOCATION=checkpoints/restaurant-notifications
TRIGGER_INTERVAL='30 seconds'
SPARK_MASTER='local[2]'
